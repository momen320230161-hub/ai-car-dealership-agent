# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_DAYS=7

# PostgreSQL / Supabase
# Recommended for local IPv4 development: Supabase Session Pooler on port 5432.
# For a long-running deployment with IPv6 support, the direct database URL is also suitable.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional server-side maintenance only (for scripts such as car image Storage sync).
# Never expose this value in browser JavaScript or commit a real key.
SUPABASE_SECRET_KEY=
CAR_IMAGE_BUCKET=car-images
# Admin car images: 5 MB per file, 8 MB maximum multipart request.
MAX_CAR_IMAGE_BYTES=5242880
MAX_CONTENT_LENGTH=16777216

# Phase 3 embeddings / RAG. Credentials are validated only when embeddings are used.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=
RAG_TOP_K=4
RAG_MAX_TOP_K=20
# RAG_MIN_SCORE=

# LangGraph sales orchestrator.
AGENT_LLM_PROVIDER=gemini
AGENT_LLM_MODEL=gemini-3.5-flash-lite
AGENT_LLM_TEMPERATURE=0.1
AGENT_MAX_MESSAGE_LENGTH=4000
AGENT_RECENT_MESSAGE_LIMIT=12
AGENT_RECOMMENDATION_LIMIT=3

# PDF Knowledge Ingestion (optional/bonus feature).
# These limits guard against oversized or malicious uploads.
# MAX_KNOWLEDGE_PDF_BYTES=10485760   # 10 MB default
# MAX_KNOWLEDGE_PDF_PAGES=50         # max pages per PDF
# MAX_KNOWLEDGE_EXTRACTED_CHARS=100000  # max extracted characters
